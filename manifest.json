{
  "manifest_version": 3,
  "name": "Archive This!",
  "version": "1.1.1",
  "description": "Open the newest public archived version of the current page with one click.",
  "author": "Alex Hoang",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "Open newest archived copy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
